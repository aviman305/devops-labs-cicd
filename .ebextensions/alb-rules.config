Resources:
  AWSEBV2LoadBalancer:
    Type: AWS::ElasticLoadBalancingV2::LoadBalancer
    Properties:
      Name: awseb-AWSEBV2LoadBalancer-EXAMPLE
      Type: application
      Scheme: internet-facing
      Subnets:
        - subnet-XXXXXXXX
        - subnet-YYYYYYYY
      SecurityGroups:
        - sg-ZZZZZZZZ
      Tags:
        - Key: Name
          Value: awseb-load-balancer

  AWSEBV2TargetGroup:
    Type: AWS::ElasticLoadBalancingV2::TargetGroup
    Properties:
      Name: awseb-AWSEBV2TargetGroup-EXAMPLE
      Port: 80
      Protocol: HTTP
      VpcId: vpc-XXXXXXXX
      TargetType: instance
      HealthCheckEnabled: true
      HealthCheckProtocol: HTTP
      HealthCheckPath: /health
      HealthCheckIntervalSeconds: 30
      HealthCheckTimeoutSeconds: 5
      HealthyThresholdCount: 3
      UnhealthyThresholdCount: 3
